# ============================================
# Konfigurasi Environment - FAS Management
# ============================================
# Salin file ini menjadi .env.local untuk development:
#   cp .env.example .env.local
# Lalu isi nilai asli dari dashboard Supabase Anda
# (Project Settings > API).
#
# PENTING KEAMANAN:
# - File .env* TIDAK di-commit ke git (lihat .gitignore)
# - Untuk production, set variabel ini di dashboard Vercel
#   (Project Settings > Environment Variables)

# Supabase Configuration
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# API URL backend opsional (jika ada) - tanpa trailing slash
VITE_API_URL=